# Copiar a .env para desarrollo local. En producción van como variables en Railway.

# Contraseña de acceso a la app
APP_PASSWORD=cambia-esto

# Secreto para firmar la cookie de sesión (string largo y aleatorio)
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Duración de la sesión en días (opcional, default 30)
SESSION_DAYS=30
